{
  "name": "trip-planner",
  "version": "1.8.0",
  "private": true,
  "type": "module",
  "description": "Gamil Family Trips — Daily Trip Planner with Google Auth & Push Notifications",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 8080",
    "deploy": "firebase deploy",
    "build:native": "vite build && cap sync",
    "android:open": "cap open android",
    "android:bundle": "vite build && cap sync android && cd android && gradlew bundleRelease",
    "assets:generate": "node scripts/make-icons.mjs && capacitor-assets generate --android --ios --iconBackgroundColor #5b5ef0 --splashBackgroundColor #0a0e1a --splashBackgroundColorDark #0a0e1a"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.6.0",
    "@capacitor-firebase/messaging": "^8.6.0",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/splash-screen": "^8.0.2",
    "firebase": "^12.19.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.6.0",
    "vite": "^7.0.0"
  }
}
